# Telegram Bot Configuration for Dr. Sara & Eng. Tewodros Wedding
# Keep this file private and NEVER commit real secrets to public repositories

# Obtain your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Bot username (e.g. sara_tewodros_wedding_bot)
TELEGRAM_BOT_USERNAME=sara_tewodros_wedding_bot

# Passcode that Sara and Tewodros can type in Telegram (/admin_login <passcode>) to claim admin status
ADMIN_PASSCODE=sara_tewodros_royal_2026

# Optional: Pre-configured Telegram Chat IDs for Dr. Sara and Eng. Tewodros (leave blank to let them claim via passcode)
SARA_CHAT_ID=
TEWODROS_CHAT_ID=

# Server Port
PORT=8080
